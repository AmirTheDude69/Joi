{
  "name": "joi-assistant",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "turbo dev --parallel",
    "dev:agent": "pnpm --filter @joi/agent dev",
    "dev:web": "pnpm --filter @joi/web dev",
    "build:macos": "./scripts/build-macos.sh",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "turbo": "^2.10.7",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server": "2.0.12",
      "fast-uri": "3.1.4",
      "postcss": "8.5.24",
      "sharp": "0.35.3"
    }
  }
}
