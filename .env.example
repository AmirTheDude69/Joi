# Core runtime
NODE_ENV=development
PORT=8787
JOI_WEB_ORIGIN=http://localhost:3000
JOI_DEV_AUTH_TOKEN=demo-user
JOI_ALLOW_DEMO_MODE=true

# OpenAI (optional; demo mode works without a key)
OPENAI_API_KEY=
OPENAI_FAST_MODEL=gpt-5-mini
OPENAI_STRONG_MODEL=gpt-5.1

# Persistence contract (adapter is a production release gate; beta uses memory)
DATABASE_URL=postgres://joi:joi@localhost:5432/joi
JOI_ENCRYPTION_KEY=

# Google OAuth launch gate
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/oauth/google/callback

# Web server-only proxy configuration
JOI_AGENT_API_URL=http://localhost:8787
JOI_AGENT_AUTH_TOKEN=demo-user

# Public release gates
JOI_LIKENESS_RELEASE_APPROVED=false
JOI_TRADEMARK_CLEARANCE_APPROVED=false
